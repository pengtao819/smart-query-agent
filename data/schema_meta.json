            "paid",
            "cancelled",
            "refunded",
            "shipped",
            "completed"
          ]
        },
        {
          "name": "total_amount",
          "type": "DECIMAL(12,2)",
          "description": "订单实付金额 = 商品金额 - 优惠 + 运费"
