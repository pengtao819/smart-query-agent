    {
      "name": "dim_date",
      "description": "日期维表，一行一天。按日/月/季度/节假日聚合都从这里取。",
      "grain": "一天一行",
      "row_count": 730,
      "columns": [
        {
          "name": "date_key",
          "type": "DATE",
          "description": "日期主键，例如 2026-09-01"
        },
        {
          "name": "year_num",
          "type": "INTEGER",
          "description": "年份"
        },
        {
          "name": "quarter_num",
          "type": "INTEGER",
          "description": "季度 1-4"
        },
        {
          "name": "month_num",
          "type": "INTEGER",
          "description": "月份 1-12"
