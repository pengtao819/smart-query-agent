    {
      "name": "fact_order",
      "description": "订单主表：一行一个订单，金额是订单级汇总。",
      "grain": "一个订单一行",
      "row_count": 30000,
      "columns": [
        {
          "name": "order_id",
          "type": "BIGINT",
          "description": "订单主键"
        },
        {
          "name": "customer_id",
          "type": "INTEGER",
          "description": "下单客户 ID"
        },
        {
          "name": "region_id",
          "type": "INTEGER",
          "description": "收货区域 ID（可能不等于客户所在城市）"
