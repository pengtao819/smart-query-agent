          "name": "discount_amount",
          "type": "DECIMAL(12,2)",
          "description": "优惠金额"
        },
        {
          "name": "shipping_fee",
          "type": "DECIMAL(12,2)",
          "description": "运费"
        },
        {
          "name": "created_at",
          "type": "TIMESTAMP",
          "description": "下单时间（含时分秒）"
        }
      ]
    },
