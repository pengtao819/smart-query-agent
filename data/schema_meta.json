        {
          "name": "year_month",
          "type": "VARCHAR",
          "description": "年月，例如 2026-09，方便按月分组",
          "sample_values": [
            "2025-08",
            "2025-01",
            "2025-05",
            "2025-12",
            "2025-09",
            "2026-07",
            "2026-03",
            "2026-12",
            "2025-02",
            "2026-01",
            "2026-04",
            "2025-04"
